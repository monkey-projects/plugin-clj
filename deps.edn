{:deps {com.monkeyci/script {:mvn/version "0.27.0-SNAPSHOT"}
        com.monkeyci/plugin-junit {:mvn/version "0.3.0-SNAPSHOT"}}

 :paths ["src"]
 
 :aliases
 {:test
  ;; clj -X:test
  {:extra-deps {com.monkeyprojects/build {:mvn/version "0.3.1"}}
   :extra-paths ["test"]
   :exec-fn monkey.test/all}

  :junit
  ;; clj -X:test:junit
  {:exec-fn monkey.test/junit}

  :watch
  ;; clj -X:test:watch
  {:exec-fn monkey.test/watch}

  :jar
  ;; clj -X:jar
  {:extra-deps {com.monkeyprojects/build {:mvn/version "0.3.1"}}
   :exec-fn monkey.build/jar
   :exec-args {:jar "target/plugin-clj.jar"
               :lib com.monkeyci/plugin-clj
               :version [[:env "LIB_VERSION"] "0.5.0-SNAPSHOT"]
               :pom-data [[:licenses
                           [:license
                            [:name "MIT"]
                            [:url "https://mit-license.org/"]]]]
               :scm {:url "https://github.com/monkey-projects/plugin-clj"}}}

  :install
  ;; clj -X:jar:install
  {:exec-fn monkey.build/jar+install}
  
  :publish
  ;; clj -X:jar:publish
  {:exec-fn monkey.build/jar+deploy}}}
